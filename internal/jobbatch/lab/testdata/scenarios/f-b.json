{
  "version": 1,
  "limits": {
    "max_concurrent": 2,
    "max_depth": 8,
    "max_nodes": 64
  },
  "runner": {
    "control_timeout_ms": 1000,
    "record_retention": 128
  },
  "wait_bound_ms": 10000,
  "payloads": {
    "p": {
      "kind": "controlled"
    }
  },
  "script": [
    {
      "action": "submit",
      "ref": "fb-R",
      "root": "R",
      "spec": {
        "batch": {
          "mode": "parallel",
          "notify": "each",
          "items": [
            {
              "task": {
                "payload_ref": "p"
              }
            },
            {
              "batch": {
                "mode": "parallel",
                "notify": "all",
                "items": [
                  {
                    "task": {
                      "payload_ref": "p"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "action": "await_start",
      "node": "R.1",
      "bind": "r1"
    },
    {
      "action": "release_start",
      "attempt": "r1",
      "decision": "accept"
    },
    {
      "action": "await_state",
      "node": "R.1",
      "state": "running"
    },
    {
      "action": "await_start",
      "node": "R.2.1",
      "bind": "r21"
    },
    {
      "action": "release_start",
      "attempt": "r21",
      "decision": "accept"
    },
    {
      "action": "await_state",
      "node": "R.2.1",
      "state": "running"
    },
    {
      "action": "close",
      "async": "c",
      "expect": "ok"
    },
    {
      "action": "await_record",
      "type": "host_closing"
    },
    {
      "action": "await_stop",
      "attempt": "r1",
      "call": 1
    },
    {
      "action": "await_stop",
      "attempt": "r21",
      "call": 1
    },
    {
      "action": "complete",
      "attempt": "r1",
      "state": "interrupted"
    },
    {
      "action": "await_record",
      "type": "settled",
      "node": "R.1"
    },
    {
      "action": "complete",
      "attempt": "r21",
      "state": "interrupted"
    },
    {
      "action": "await_record",
      "type": "settled",
      "node": "R.2.1"
    },
    {
      "action": "join",
      "name": "c"
    },
    {
      "action": "complete",
      "attempt": "r1",
      "state": "completed",
      "expect_error": "unknown_attempt"
    },
    {
      "action": "expect_output",
      "eof": true,
      "node": "R.1",
      "expect_error": "closed"
    },
    {
      "action": "stop",
      "node": "R.1",
      "expect_error": "closed"
    },
    {
      "action": "capacity_available",
      "group": "",
      "expect_error": "closed"
    },
    {
      "action": "release",
      "root": "R",
      "expect_error": "closed"
    },
    {
      "action": "add",
      "ref": "fb-add",
      "parent": "R",
      "items": [
        {
          "task": {
            "payload_ref": "p"
          }
        }
      ],
      "expect_error": "closed"
    },
    {
      "action": "submit",
      "ref": "fb-N",
      "root": "N",
      "spec": {
        "task": {
          "payload_ref": "p"
        }
      },
      "expect_error": "closed"
    },
    {
      "action": "close",
      "expect": "ok"
    }
  ],
  "expect": {
    "roots": [
      {
        "id": "R",
        "state": "interrupted"
      }
    ],
    "nodes": [
      {
        "id": "R.1",
        "starts": 1,
        "accepted": 1,
        "stops": 1,
        "disposes": 1
      },
      {
        "id": "R.2.1",
        "starts": 1,
        "accepted": 1,
        "stops": 1,
        "disposes": 1
      }
    ],
    "notices": {
      "R": [
        {
          "node": "R.1",
          "state": "interrupted"
        },
        {
          "node": "R.2",
          "state": "interrupted"
        },
        {
          "node": "R",
          "state": "interrupted"
        }
      ]
    },
    "max_active": 2,
    "exit_code": 1
  }
}
