#!/usr/bin/env bash
# pre-push: mirror the CI gates so a red build never reaches origin.
#
# Runs the same checks as .github/workflows/{build,lint}.yml:
#   1. go build ./...                 — compile + //go:embed all:dist
#   2. golangci-lint run              — v2.13, same as lint.yml (covers gofumpt),
#                                       once per GOOS in the CI matrix so
#                                       build-tagged files aren't skipped
#   3. go test -short -failfast ./... — like build.yml, minus -race (that needs
#                                       a local gcc/cgo that isn't guaranteed)
#
# golangci-lint is used from PATH when present, otherwise `go run` fetches the
# pinned version (downloaded once into the module cache, then reused).
#
# This session root-caused three genuine Windows-only test races (see git
# log for internal/agent/cliprovider/provider_test.go,
# internal/agent/tools/mcp/process_windows_test.go, and
# internal/cmd/models_use_test.go) — each fixed AT THE SPECIFIC TEST, not by
# slowing the whole suite down. (An earlier version of this hook also capped
# -p/-parallel globally as extra defense-in-depth against those races; once
# the races themselves were fixed, that cap was removed as unnecessary
# overhead. A DIFFERENT, later problem brought throttling back in a
# narrower form: a genuine Windows commit-limit OOM (ERROR_COMMITMENT_LIMIT,
# not a race) from running `go test ./...` with full default -p/-parallel —
# see run_capped's comment below for the concrete fix, which mirrors what
# build.yml/test-agent already do in CI for the exact same reason.)
# A transparent retry-once remains below as a cheap backstop for whatever
# rare environment-driven flakiness still slips through (AV scanning,
# genuine OS scheduling lag): a real regression fails identically on both
# attempts, so this cannot mask real breakage, and the common case (no
# flake) never pays for it.
#
# The retry is scoped to only the package(s) that actually failed (task
# #455, following up on task #450's test-speed investigation), not the
# whole `./...` suite — re-running everything used to mean a single flake
# anywhere re-paid the full suite's time twice, which mattered a lot more
# before task #450-#454 cut that time by ~50%+. If no failing package can
# be parsed out of the first attempt's output, this falls back to
# retrying the whole suite rather than silently skipping the retry.
#
# Bypass in an emergency with:  git push --no-verify
set -uo pipefail

# Keep in sync with golangci_version in .github/workflows/lint.yml.
GOLANGCI_VERSION="v2.13"

cd "$(git rev-parse --show-toplevel)" || exit 1

fail() { printf '\n\033[31m✗ pre-push: %s\033[0m\n' "$1" >&2; exit 1; }
step() { printf '\033[36m▸ %s\033[0m\n' "$1"; }

# Windows commit-limit OOM backstop (ERROR_COMMITMENT_LIMIT / errno=1455):
# this hook used to run go build/test bare, with full default -p/-parallel.
# CI already learned the hard way that internal/agent combined with ANY
# other package under -p >1 can blow the commit limit on windows-latest
# (see build.yml's own comment on the dedicated test-agent job) -- this
# hook had never applied the same lesson to itself, and a live pre-push run
# on this machine hit exactly that crash (multiple ".test" binaries dying
# mid-compile with "runtime: VirtualAlloc ... errno=1455") while running
# the unthrottled `go test ./...` below. Two independent layers, same
# philosophy as CI's GOMEMLIMIT + batching:
#   1. -p 2 everywhere (portable, no extra tooling, matches every CI step)
#     and internal/agent tested ALONE with -parallel 2 on top of that,
#     exactly like build.yml/test-agent split it out.
#   2. run_capped: a HARD ceiling via safego.ps1 (this machine's Job-Object
#     memory-cap + wall-clock-timeout wrapper, see CLAUDE.md) when present.
#     It is a personal, machine-local tool, never committed to the repo --
#     absent on any other contributor's machine or CI -- so this degrades
#     to running the command bare there. -p 2 alone is CI's own proven
#     mitigation and works with no dependency at all; safego.ps1 is
#     defense-in-depth on top of it, not a requirement.
SAFEGO="C:\\Users\\Computer\\AppData\\Local\\safego\\safego.ps1"
run_capped() {
	local size="$1" timeout="$2"
	shift 2
	if [ "$(go env GOHOSTOS)" = "windows" ] && [ -f "$SAFEGO" ]; then
		powershell -NoProfile -ExecutionPolicy Bypass -File "$SAFEGO" "$size" "$timeout" "$@"
	else
		"$@"
	fi
}

step "go build ./..."
run_capped 3g 240 go build -p 2 ./... || fail "build failed"

gcl=""
if command -v golangci-lint >/dev/null 2>&1; then
	gcl="golangci-lint"
elif [ -x "$(go env GOPATH)/bin/golangci-lint" ]; then
	gcl="$(go env GOPATH)/bin/golangci-lint"
elif [ -x "$(go env GOPATH)/bin/golangci-lint.exe" ]; then
	gcl="$(go env GOPATH)/bin/golangci-lint.exe"
fi

if [ -n "$gcl" ]; then
	# Announce the version that will ACTUALLY run, not the pinned one. Only
	# the `go run` fallback is pinned; a binary found on PATH is whatever
	# happens to be installed, and printing "$GOLANGCI_VERSION" over it
	# would claim a match with CI that nobody checked. A mismatch is not
	# fatal — it is usually a newer local install — but it explains a
	# finding CI does not report, or the reverse.
	gcl_version="$("$gcl" version 2>/dev/null | head -1)"
	step "golangci-lint run — ${gcl_version:-unknown version} (CI pins $GOLANGCI_VERSION)"
	case "$gcl_version" in
	*"$(printf '%s' "$GOLANGCI_VERSION" | tr -d v)"*) ;;
	*) printf '\033[33m⚠ local golangci-lint is not %s; findings may differ from CI\033[0m\n' "$GOLANGCI_VERSION" ;;
	esac
	"$gcl" run || fail "lint failed"
else
	step "golangci-lint run ($GOLANGCI_VERSION, via go run)"
	# -p 2 (build flag, must precede the package path): this compiles the
	# whole golangci-lint module tree at full default parallelism
	# otherwise -- the heaviest single unthrottled Go compile this hook
	# can trigger when no golangci-lint binary is on PATH.
	run_capped 3g 300 go run -p 2 "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_VERSION}" run \
		|| fail "lint failed (ran via 'go run'; install golangci-lint for speed)"
fi

# Cross-GOOS lint. lint.yml runs on ubuntu, macos AND windows, but the pass
# above only ever sees the HOST's build tags — a file behind //go:build
# !windows is invisible from Windows, and vice versa. That is not
# hypothetical: a noctx finding in internal/session/track_unix_test.go
# sailed through a green pre-push here and turned the lint workflow red,
# which is the one thing this hook exists to prevent.
#
# `go run` cannot do this pass: with GOOS set it builds a foreign
# golangci-lint binary and then cannot exec it. So when no native binary is
# available this is skipped — and the skip is carried all the way to the
# final line. Warning here and then printing a bare green tick after
# several minutes of test output would leave "everything passed" on screen
# while a third of the CI lint matrix was never looked at, which is a
# quieter version of the exact failure this pass was added to prevent.
cross_goos_skipped=""
if [ -n "$gcl" ]; then
	host_goos="$(go env GOHOSTOS)"
	for goos in linux darwin windows; do
		[ "$goos" = "$host_goos" ] && continue
		step "golangci-lint run — GOOS=$goos"
		GOOS="$goos" "$gcl" run || fail "lint failed for GOOS=$goos (CI lints all three)"
	done

	# One GOARCH pass, and it is not paranoia: internal/db picks its SQLite
	# driver on a GOOS×GOARCH tag pair (connect_modernc.go lists the
	# supported pairs, connect_ncruces.go is the negation). Every host and
	# every CI runner lands on the modernc side, so the ncruces file is
	# compiled and linted by NOBODY — not here, not on ubuntu, macos or
	# windows. linux/mips64 is outside the modernc list, so this pass is
	# the only thing that ever looks at it.
	step "golangci-lint run — GOOS=linux GOARCH=mips64 (the SQLite driver nothing else covers)"
	GOOS=linux GOARCH=mips64 "$gcl" run ./internal/db/... \
		|| fail "lint failed for the ncruces SQLite driver branch"
else
	cross_goos_skipped="yes"
	printf '\033[33m⚠ skipping the cross-GOOS lint passes — they need a native golangci-lint (go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@%s); CI still lints linux/macos/windows\033[0m\n' "$GOLANGCI_VERSION"
fi

# ASCII-only guard for the sqlc query sources.
#
# sqlc v1.30.0 miscounts query spans when a .sql comment contains a
# multi-byte character: it appears to measure offsets in bytes and positions
# in runes, so each non-ASCII character shifts the generated SQL's end by the
# difference. Adding a comment with two em-dashes to orphan_outbox.sql
# silently truncated that query's tail (RETURNING ... became
# RETURNING ... max_atte), and a longer non-ASCII block corrupted an
# UNRELATED query at the top of the same file into invalid SQL. `sqlc
# generate` exits 0 either way and the generated Go still compiles; the
# statement fails at Prepare time, which for this codebase means at process
# start.
#
# PCRE's [:ascii:] class, negated -- deliberately escape-free. Writing this
# as a hex byte-range character class put REAL NUL and DEL bytes into this
# hook, because the escapes were consumed before the file was written, and
# it then matched every file. The POSIX [^[:print:][:space:]] alternative
# was worse: it silently matched NOTHING here, so the check passed on a
# file that did contain an em-dash.
# Both were caught only by testing the guard against a deliberately violating
# tree as well as a clean one -- do the same if you change this line.
#
# Nothing else in the toolchain notices, and this repository's prose style
# uses em-dashes freely, so the only thing keeping it from recurring is this
# check. Bytes > 0x7F only -- deliberately cruder than a Unicode-aware test,
# because the failure is about bytes.
step "internal/db/sql is ASCII-only (sqlc miscounts spans around multi-byte comments)"
if offenders="$(grep -lP "[^[:ascii:]]" internal/db/sql/*.sql 2>/dev/null)" && [ -n "$offenders" ]; then
	printf '[31mnon-ASCII bytes in:[0m
%s
' "$offenders"
	fail "a non-ASCII character in a .sql file silently corrupts sqlc codegen -- replace it with an ASCII equivalent"
fi

# Stale model-slot-name guard (large/small -> smart/fast rename). See
# .githooks/check_stale_model_slots.sh for the full rationale: two
# independent reviews found the rename's hand-swept text pass (the
# go/scanner tool deliberately only patched Go IDENT tokens, to avoid
# mangling legitimate prose like "a large thinking budget") had missed
# live --large/--small flag mentions, models.large/models.small config-key
# docs, and quoted "large"/"small" slot names in --help text, error
# strings, and the bundled rush-config skill. Nothing else in the
# toolchain would catch this -- it is not a compile error and go vet does
# not know these strings are supposed to be in sync with the Go identifiers.
step "no stale large/small model-slot spelling (renamed to smart/fast)"
bash .githooks/check_stale_model_slots.sh || fail "stale large/small model-slot text found -- see output above"

# db.Connect/db.ConnectRead pairing guard for test files.
# internal/db/connect.go's Connect/ConnectRead hand out handles from a
# ref-counted pool whose entries are only torn down by db.Release; a
# test that "cleans up" with conn.Close() on the raw *sql.DB bypasses
# the refCount and leaks the pool entry plus its database/sql
# connectionOpener goroutine per call -- the mechanism that chronically
# killed ubuntu CI runners before the fix
# (docs/lessons/2026-08-30-ci-goroutine-leak.md). Nothing in the
# compiler/vet/staticcheck toolchain can see the invariant, so a
# same-file occurrence count is the guard, same philosophy as the
# ASCII-SQL and stale-slot guards above.
step "test files pair db.Connect/db.ConnectRead with db.Release (ref-counted pool contract)"
bash .githooks/check_db_release_pairing.sh || fail "unpaired db.Connect/db.ConnectRead in a test file -- see output above"

# The web UI's typecheck. rsbuild (pnpm build) does NOT check types, so
# without this nothing in the project does — which is how five errors,
# including a required prop that silently changed how tool groups render,
# sat in the tree unnoticed. Skipped when the dependencies are not
# installed: a Go-only change should not have to run pnpm install first.
if [ -d web/node_modules ]; then
	step "pnpm typecheck (web)"
	(cd web && pnpm typecheck) || fail "web typecheck failed"
else
	printf '\033[33m⚠ skipping the web typecheck — web/node_modules is absent (run: cd web && pnpm install)\033[0m\n'
fi

# run_test_segment: same first-attempt/parse-failed-packages/retry-once
# logic as the old single `go test ./...` block below, just parameterized
# so it can run over a SUBSET of packages with its own -p/-parallel/size
# budget instead of one unthrottled `./...` call. See run_capped's comment
# above for why this split exists at all (internal/agent + -p >1 is a
# proven Windows OOM trigger CI already isolates; this hook now does too).
run_test_segment() {
	local label="$1" size="$2" timeout="$3"
	shift 3
	local test_log
	test_log="$(mktemp)"
	step "go test -short -failfast $label"
	if run_capped "$size" "$timeout" go test -short -failfast "$@" 2>&1 | tee "$test_log"; then
		printf '\033[32m(tests passed on the first attempt: %s)\033[0m\n' "$label"
	else
		# Package(s) that actually reported FAIL, e.g.
		# "FAIL	github.com/.../internal/session	3.45s" -> the package path.
		failed_pkgs="$(grep -E '^FAIL[[:space:]]' "$test_log" | awk '{print $2}' | sort -u | tr '\n' ' ')"
		if [ -z "${failed_pkgs// /}" ]; then
			printf '\033[33m⚠ %s failed once — could not identify which package from the output, retrying the whole segment (known rare Windows flakiness, see comment above)\033[0m\n' "$label"
			run_capped "$size" "$timeout" go test -short -failfast "$@" || fail "$label failed twice in a row — not the known flake, treat as real"
		else
			printf '\033[33m⚠ %s failed once in: %s — retrying just that/those package(s) (known rare Windows flakiness, see comment above)\033[0m\n' "$label" "$failed_pkgs"
			# shellcheck disable=SC2086
			run_capped "$size" "$timeout" go test -short -failfast $failed_pkgs || fail "$label failed twice in a row in $failed_pkgs — not the known flake, treat as real"
		fi
		printf '\033[33m(tests passed on retry: %s)\033[0m\n' "$label"
	fi
	rm -f "$test_log"
}

# internal/agent alone, throttled: 172+ t.Parallel() sites in one package
# at default parallelism (GOMAXPROCS) is the single biggest commit-limit
# contributor found this session -- -parallel 2 keeps peak concurrent test
# state (sqlite DBs, httptest servers, SSE buffers) bounded regardless of
# how many logical CPUs this machine has.
run_test_segment "internal/agent (isolated, throttled)" 2g 300 -parallel 2 ./internal/agent/

# Everything else, -p 2 like every CI test step in build.yml -- internal/agent
# is excluded here (already covered above) so this list is never combined
# with it under shared package-build parallelism, the other half of the
# same proven Windows OOM trigger.
# shellcheck disable=SC2046
run_test_segment "./... (minus internal/agent)" 3g 480 -p 2 $(go list ./... | grep -v '^github.com/PHPCraftdream/rush/internal/agent$')

# The process-group and lock-fence suites, which -short deliberately skips
# (they spawn real child processes). build.yml runs these on ubuntu; mirror
# that here so the hook's claim at the top of this file stays true.
#
# On Windows the files are excluded by a !windows build tag, so there is
# nothing to run and pretending otherwise would be worse than skipping —
# say so out loud instead.
case "$(go env GOOS)" in
windows)
	printf '\033[33m⚠ skipping the process-group/lock-fence suites — they are !windows-tagged, so this host cannot run them at all (CI covers them on ubuntu)\033[0m\n'
	;;
*)
	step "process-group and lock-fence suites (no -short)"
	run_capped 2g 180 go test -p 2 -failfast -run 'ChildGroup|Registry|WriteChildGroupFile|VerifyGroupStillPlausible|Sweep|ProbeThenKillHolder|AcquireSessionLockForReset|ForceKillHolder|ForceStillKillsLiveHolder' \
		./internal/session/ ./internal/cmd/ || fail "process-group/lock-fence suites failed"
	;;
esac

if [ -n "$cross_goos_skipped" ]; then
	printf '\033[33m✓ pre-push checks passed — but lint covered the HOST GOOS ONLY; the other two in the CI matrix were not checked\033[0m\n'
else
	printf '\033[32m✓ pre-push checks passed\033[0m\n'
fi
