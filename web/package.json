{
  "name": "rush-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "minimumReleaseAge": 4320,
    "minimumReleaseAgeExclude": []
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:base && pnpm run lint:carburetor",
    "lint:base": "oxlint --max-warnings=101",
    "lint:carburetor": "oxlint --threads 1 -c .oxlintrc.carburetor.json --max-warnings=0",
    "preview": "rsbuild preview",
    "test": "node scripts/run-tests.mjs",
    "test:ui": "node scripts/run-tests.mjs --ui",
    "test:real-backend": "playwright test --config tests/real-backend/playwright.config.ts"
  },
  "dependencies": {
    "@react-carburetor/core": "0.1.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-carburetor/lint": "0.1.0",
    "@rsbuild/core": "^1.4.6",
    "@rsbuild/plugin-react": "^1.2.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "oxlint": "1.82.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
